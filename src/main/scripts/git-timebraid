#!/bin/sh
#
# git-timebraid launcher.
#
# Expects the layout of the distribution archive:
#
#     bin/git-timebraid   <- this script
#     lib/git-timebraid.jar
#
# Put bin/ on PATH and both `git-timebraid …` and `git timebraid …` work, the latter because git
# runs any `git-<name>` it finds on PATH as a subcommand.
#
# The JVM is looked for in this order, first hit wins:
#
#     $TIMEBRAID_JAVA        an explicit java binary
#     <install>/runtime/     the bundled runtime, present only in the platform-specific archive
#     $JAVA_HOME/bin/java
#     java on PATH
#
# The bundled runtime outranks JAVA_HOME on purpose: the point of that archive is to run on a
# machine whose Java is absent, old, or not the one this was tested against. TIMEBRAID_JAVA is the
# way out when you do want your own.
#
# Environment:
#     TIMEBRAID_JAVA   java binary to run, overriding everything below it
#     JAVA_HOME        the JVM to use when there is no bundled runtime
#     JAVA_OPTS        passed to the JVM, typically a larger heap for a large graph:
#                      JAVA_OPTS=-Xmx4g git-timebraid -o /tmp/merged repo-a.git repo-b.git

set -e

# Resolve this script through any symlinks — an entry on PATH is usually one, and the jar is found
# relative to the real location, not to the link. Plain `readlink` reads one link and is portable
# enough; `readlink -f`, which would resolve the whole chain, is not, hence the loop.
script=$0
while [ -h "$script" ]; do
    target=$(readlink -- "$script")
    case $target in
        /*) script=$target ;;
        *)  script=$(dirname -- "$script")/$target ;;
    esac
done
home=$(cd -- "$(dirname -- "$script")/.." > /dev/null && pwd)

jar=$home/lib/git-timebraid.jar
if [ ! -f "$jar" ]; then
    echo "git-timebraid: jar not found at $jar" >&2
    echo "git-timebraid: expected bin/ and lib/ side by side, as laid out by the distribution archive" >&2
    exit 1
fi

if [ -n "${TIMEBRAID_JAVA:-}" ]; then
    java=$TIMEBRAID_JAVA
elif [ -x "$home/runtime/bin/java" ]; then
    java=$home/runtime/bin/java
elif [ -n "${JAVA_HOME:-}" ]; then
    java=$JAVA_HOME/bin/java
else
    java=java
fi

# JAVA_OPTS is deliberately unquoted: it holds several JVM options and has to word-split.
# shellcheck disable=SC2086
exec "$java" ${JAVA_OPTS} -jar "$jar" "$@"
