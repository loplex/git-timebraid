<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cz.loplex</groupId>
    <artifactId>git-timebraid</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>git-timebraid</name>
    <description>
        Merge several independent git repositories into one, braided together along the time axis:
        every commit is recreated, every original parent edge is kept, and artificial edges chain
        commits across repositories in timestamp order.
    </description>

    <url>https://github.com/loplex/git-timebraid</url>

    <scm>
        <connection>scm:git:https://github.com/loplex/git-timebraid.git</connection>
        <developerConnection>scm:git:git@github.com:loplex/git-timebraid.git</developerConnection>
        <url>https://github.com/loplex/git-timebraid</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/loplex/git-timebraid/issues</url>
    </issueManagement>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <kotlin.version>2.4.10</kotlin.version>
        <kotlin.compiler.jvmTarget>17</kotlin.compiler.jvmTarget>

        <jgit.version>7.7.1.202607240634-r</jgit.version>
        <slf4j.version>2.0.18</slf4j.version>
        <clikt.version>5.1.0</clikt.version>
        <junit.version>5.14.4</junit.version>

        <main.class>cz.loplex.timebraid.MainKt</main.class>

        <!--
            The JDK modules the bundled runtime carries (profile `bundled-runtime`, at the bottom of this file).
            Derived from `jdeps` with `print-module-deps` over the jars in lib/,
            minus one module and plus two that change the image, each deviation for a reason jdeps cannot see:

            - java.desktop is dropped.
              jdeps reports it because com.sun.jna.Native declares methods taking java.awt.Window;
              the JVM resolves a method descriptor when the method is called, not when the class initialises,
              and nothing here calls those.
              Verified against a real terminal: mordant still detects the terminal size through JNA.
              Saves ~11 MB of ~57.
            - jdk.charsets is added.
              Charsets arrive through ServiceLoader, so jdeps never sees them;
              without it, anything outside the default charset fails, which on Windows is most of cp1250.
            - jdk.unsupported is added for sun.misc.Unsafe,
              reached reflectively by libraries that probe for it rather than linking against it.

            java.logging is on the list too, though jdeps leaves it out:
            `print-module-deps` omits a module that another one it prints requires transitively,
            as java.sql requires java.logging, and jlink adds such a module either way.
            Naming it changes nothing.
        -->
        <jlink.modules>java.base,java.logging,java.management,java.security.jgss,java.sql,jdk.charsets,jdk.unsupported</jlink.modules>

        <!--
            jlink's compression.
            `zip-6` needs JDK 21; on JDK 17 build with `-Djlink.compress=2`.
        -->
        <jlink.compress>zip-6</jlink.compress>

        <!--
            Platform of the bundled-runtime archive, set by the platform-* profiles below.
            A runtime image only runs on the platform that built it, so it has to show in the file name;
            the plain archive carries no runtime and stays portable, hence no suffix there.
        -->
        <dist.os>${os.name}</dist.os>
        <dist.arch>${os.arch}</dist.arch>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>

        <!-- Git object reading/writing (plumbing only; network operations shell out to the git CLI). -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>${jgit.version}</version>
        </dependency>

        <!--
            JGit logs through slf4j.
            Without a binding on the runtime classpath, slf4j's initializer announces itself on stderr
            ("No SLF4J providers were found.") the first time JGit logs anything, which Progress has no way to suppress.
            slf4j-simple, configured in simplelogger.properties,
            keeps a normal run silent while letting JGit's warnings through.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- CLI parsing (help, version, options). -->
        <dependency>
            <groupId>com.github.ajalt.clikt</groupId>
            <artifactId>clikt-jvm</artifactId>
            <version>${clikt.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>${kotlin.compiler.jvmTarget}</jvmTarget>
                </configuration>
            </plugin>

            <!-- Clears what one build leaves in target/ and the next would otherwise pick up. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <!--
                            target/lib/ goes into the archives whole,
                            so a jar left there by an earlier build, a dependency's old version after an upgrade,
                            would ship beside the new one.
                            Emptied in the same phase that fills it, before the copy, which is declared further down.
                        -->
                        <id>clear-lib</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/lib</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Unit tests: the pure planner and the narrow git wrappers, milliseconds each.
                Everything named *IT is an end-to-end fixture and runs in `integration-test`.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
                Integration tests:
                the whole clone -> read -> plan -> write pipeline over synthetic repositories built by TestRepoBuilder,
                plus an opt-in smoke run against a real corpus (-Dtimebraid.corpus=<dir of bare clones>).
                Bound to `verify` so `mvn verify` is the one command CI runs.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                The program's own jar, written into target/lib/ rather than target/:
                the dependencies are copied there beside it (maven-dependency-plugin, below),
                so target/lib/ is the archive's lib/ as it ships,
                and `java -jar target/lib/git-timebraid.jar` runs the program from a build
                exactly as the launchers run it from an archive.

                The manifest's Class-Path names each dependency by its file name alone,
                a sibling of the jar, which is where both places put them.
                The names are the ones maven-dependency-plugin writes;
                `useUniqueVersions` off keeps a snapshot dependency's name the same on both sides.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <outputDirectory>${project.build.directory}/lib</outputDirectory>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <mainClass>${main.class}</mainClass>
                            <addClasspath>true</addClasspath>
                            <useUniqueVersions>false</useUniqueVersions>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!--
                The runtime dependencies, each its own unmodified jar, into target/lib/ beside the program's.
                Unmodified is the point: every jar keeps its own META-INF,
                so the services each registers (mordant's three terminal backends register theirs under one name),
                the signatures of signed jars and each project's license files stay as their authors shipped them,
                with nothing to merge or choose between.
                Bound to prepare-package, so the directory is complete before the assembly reads it.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                The downloadable archive: bin/git-timebraid (plus .bat) beside lib/,
                so that putting bin/ on PATH makes both `git-timebraid …` and `git timebraid …` work.
                It runs after the jar is written:
                both bind to `package`, where maven-jar-plugin's default-jar, which the packaging itself binds,
                comes before any execution the pom adds to the phase.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/main/assembly/distribution.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <finalName>${project.artifactId}-${project.version}</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- `mvn compile exec:java` for a quick manual run during development. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
            Platform naming for the bundled-runtime archive.
            Hand-rolled rather than pulled from os-maven-plugin:
            three operating systems and two architectures is the whole matrix,
            and a build extension for it would cost more than it saves.
        -->
        <profile>
            <id>platform-linux</id>
            <activation><os><name>linux</name></os></activation>
            <properties><dist.os>linux</dist.os></properties>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <properties><dist.os>macos</dist.os></properties>
        </profile>
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties><dist.os>windows</dist.os></properties>
        </profile>
        <profile>
            <id>platform-x64</id>
            <activation><os><arch>amd64</arch></os></activation>
            <properties><dist.arch>x64</dist.arch></properties>
        </profile>
        <profile>
            <!-- Same architecture, spelled the other way by macOS JDKs. -->
            <id>platform-x64-alias</id>
            <activation><os><arch>x86_64</arch></os></activation>
            <properties><dist.arch>x64</dist.arch></properties>
        </profile>
        <profile>
            <id>platform-aarch64</id>
            <activation><os><arch>aarch64</arch></os></activation>
            <properties><dist.arch>aarch64</dist.arch></properties>
        </profile>

        <!--
            `mvn -Pbundled-runtime package` adds a second archive that carries a trimmed JVM,
            for people who would rather not install one.
            It is opt-in and produced in addition to the portable archive, never instead of it:
            a runtime image is built by and for one platform,
            so producing it by default would quietly make the release platform-specific.

            jlink, not GraalVM native-image:
            the bundle is a real JVM, so no reflection metadata has to be maintained for JGit,
            and nothing can fail at a user's machine that did not already fail here.
            The cost is size (~56 MB unpacked against ~10 MB) and one build per platform.
        -->
        <profile>
            <id>bundled-runtime</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <!-- jlink refuses to write into a directory that already exists. -->
                                <id>clear-runtime-image</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${project.build.directory}/runtime</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jlink-runtime</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <!-- The JDK running Maven is the one that gets bundled. -->
                                    <executable>${java.home}/bin/jlink</executable>
                                    <arguments>
                                        <argument>--add-modules</argument>
                                        <argument>${jlink.modules}</argument>
                                        <argument>--strip-debug</argument>
                                        <argument>--no-header-files</argument>
                                        <argument>--no-man-pages</argument>
                                        <argument>--compress=${jlink.compress}</argument>
                                        <argument>--output</argument>
                                        <argument>${project.build.directory}/runtime</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>distribution-with-runtime</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/main/assembly/distribution-with-runtime.xml</descriptor>
                                    </descriptors>
                                    <appendAssemblyId>false</appendAssemblyId>
                                    <finalName>${project.artifactId}-${project.version}-${dist.os}-${dist.arch}</finalName>
                                    <!--
                                        Two paths under runtime/conf/security exceed tar's 100-character limit.
                                        The default already writes them as GNU long entries, it just warns each time;
                                        saying so explicitly keeps the build quiet.
                                    -->
                                    <tarLongFileMode>gnu</tarLongFileMode>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
